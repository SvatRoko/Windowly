<Window x:Class="Windowly.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windowly" Width="980" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI" FontSize="14" Foreground="#17243A">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#E8EEF9"/>
            <Setter Property="Foreground" Value="#244E91"/>
            <Setter Property="BorderBrush" Value="#CEDAF0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5EBF5"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE8FC"/><Setter Property="Foreground" Value="#174B9D"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E5EF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#EDF1F8" BorderBrush="#DFE5EF" BorderThickness="0,0,1,0" Padding="20,30">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30">
                    <TextBlock Text="Windowly" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Make room for your workflow" FontSize="11" Foreground="#5B6980" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,0,0">
                    <TextBlock Text="Running in the system tray" FontSize="12" Foreground="#5B6980"/>
                    <TextBlock Text="Closing this window keeps it running." FontSize="11" TextWrapping="Wrap" Foreground="#5B6980" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="LayoutsNav" Content="Window layouts" Style="{StaticResource Nav}" GroupName="Navigation" Tag="Layouts" Checked="Navigate"/>
                    <RadioButton Content="Taskbar" Style="{StaticResource Nav}" GroupName="Navigation" Tag="Taskbar" Checked="Navigate"/>
                    <RadioButton Content="Notification panel" Style="{StaticResource Nav}" GroupName="Navigation" Tag="Notifications" Checked="Navigate"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="CUSTOMIZATION" FontSize="11" FontWeight="SemiBold" Foreground="#526A94"/>
                <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Foreground="#5B6980"/>
            </StackPanel>
            <Grid x:Name="LayoutsPage" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Remember your workspace" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Position an application, then remember it here or from the tray menu. Its next new window will use the saved layout." TextWrapping="Wrap" Foreground="#5B6980" Margin="0,8,0,14"/>
                        <Button Content="Remember previous window" Click="Remember" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="RuleCount" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListBox x:Name="RuleList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectionChanged">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Geometry}" Foreground="#526A94" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#6A7588" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyState" Grid.Row="1" Text="No saved layouts yet. Remember an application to get started." TextWrapping="Wrap" Foreground="#5B6980" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                        <Button x:Name="DeleteButton" Grid.Row="2" Content="Delete selected layout" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Delete" IsEnabled="False"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
                    <CheckBox x:Name="StartupToggle" Content="Start Windowly at sign-in" Click="ToggleStartup"/>
                </Border>
            </Grid>
            <Border x:Name="PreviewPage" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="PLANNED FEATURE" Foreground="#526A94" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PreviewTitle" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,10"/>
                    <TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" Foreground="#5B6980"/>
                    <Border Background="#F0F4FA" CornerRadius="8" Padding="18" Margin="0,24,0,0">
                        <TextBlock Text="This is a preview page. Customization controls will be available in a future release. No Windows settings are changed." TextWrapping="Wrap" Foreground="#5B6980"/>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" Grid.Row="2" Margin="0,16,0,0" Foreground="#526A94" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>
